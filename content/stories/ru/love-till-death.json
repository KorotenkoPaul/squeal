   "messages": [
    {
     "from": "Анна",
     "text": "Тебе осталось жить пять минут."
    },
    {
     "from": "Джейк",
     "text": "Кто ты? Где я?"
    },
    {
     "from": "Джейк",
     "text": "Что это за место?"
